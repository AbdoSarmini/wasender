# After that, manage users from the Users page in the app.
# Optional: a bcrypt hash to use instead of ADMIN_PASSWORD for the seeded admin.
# ADMIN_PASSWORD_HASH=""
SESSION_SECRET="replace-this-with-a-long-random-string"
PORT=3000
